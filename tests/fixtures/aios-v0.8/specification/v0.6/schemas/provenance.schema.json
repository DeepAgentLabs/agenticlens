{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepagentlabs.github.io/ai-operations-spec/v0.6/provenance.schema.json",
  "title": "AI Operations Provenance Record",
  "description": "Exploratory 0.6-draft companion artifact recording the sources and evidence lineage behind derived findings about AIOS artifacts. Shared definitions come from the 0.4-draft common schema.",
  "type": "object",
  "required": ["spec_version", "artifact_type", "id", "created_at", "producer", "subjects", "sources", "findings", "lineage"],
  "properties": {
    "spec_version": {"const": "0.6-draft"},
    "artifact_type": {"const": "provenance"},
    "id": {"$ref": "https://deepagentlabs.github.io/ai-operations-spec/v0.4/common.schema.json#/$defs/id"},
    "created_at": {"$ref": "https://deepagentlabs.github.io/ai-operations-spec/v0.4/common.schema.json#/$defs/time"},
    "producer": {"$ref": "#/$defs/producer"},
    "subjects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subject"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "lineage": {"type": "array", "items": {"$ref": "#/$defs/lineage_edge"}},
    "attributes": {"type": "object"},
    "extensions": {"$ref": "https://deepagentlabs.github.io/ai-operations-spec/v0.4/common.schema.json#/$defs/extensions"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"$ref": "https://deepagentlabs.github.io/ai-operations-spec/v0.4/common.schema.json#/$defs/id"},
    "subject_object": {
      "description": "A v0.4 reference to an object inside the subject artifact; it can never be external.",
      "allOf": [{"$ref": "https://deepagentlabs.github.io/ai-operations-spec/v0.4/common.schema.json#/$defs/reference"}],
      "properties": {"external": {"const": false}}
    },
    "producer": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"enum": ["sha-256", "sha-384", "sha-512"]},
        "value": {"type": "string", "pattern": "^[0-9a-f]+$"}
      },
      "allOf": [
        {"if": {"properties": {"algorithm": {"const": "sha-256"}}}, "then": {"properties": {"value": {"minLength": 64, "maxLength": 64}}}},
        {"if": {"properties": {"algorithm": {"const": "sha-384"}}}, "then": {"properties": {"value": {"minLength": 96, "maxLength": 96}}}},
        {"if": {"properties": {"algorithm": {"const": "sha-512"}}}, "then": {"properties": {"value": {"minLength": 128, "maxLength": 128}}}}
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["id", "artifact_id", "artifact_type", "spec_version"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "artifact_id": {"$ref": "#/$defs/id"},
        "artifact_type": {"enum": ["workflow", "run"]},
        "spec_version": {"type": "string", "pattern": "^(0\\.[1-9][0-9]*|[1-9][0-9]*\\.(0|[1-9][0-9]*))(-draft)?$"},
        "uri": {"type": "string", "format": "uri"},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["aios_object", "artifact", "document", "dataset", "log", "tool_output", "human_input"]},
        "description": {"type": "string", "minLength": 1},
        "subject": {"$ref": "#/$defs/id"},
        "object": {"$ref": "#/$defs/subject_object"},
        "uri": {"type": "string", "format": "uri"},
        "digest": {"$ref": "#/$defs/digest"},
        "captured_at": {"$ref": "https://deepagentlabs.github.io/ai-operations-spec/v0.4/common.schema.json#/$defs/time"},
        "attributes": {"type": "object"},
        "extensions": {"$ref": "https://deepagentlabs.github.io/ai-operations-spec/v0.4/common.schema.json#/$defs/extensions"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "aios_object"}}}, "then": {"required": ["subject", "object"]}},
        {"if": {"properties": {"kind": {"const": "artifact"}}}, "then": {"required": ["subject"], "not": {"required": ["object"]}}},
        {
          "if": {"properties": {"kind": {"enum": ["document", "dataset", "log", "tool_output", "human_input"]}}},
          "then": {"anyOf": [{"required": ["uri"]}, {"required": ["description"]}], "not": {"required": ["object"]}}
        }
      ],
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": {"enum": ["rule", "model", "human", "statistical", "heuristic"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "finding_target": {
      "type": "object",
      "required": ["subject", "object"],
      "properties": {
        "subject": {"$ref": "#/$defs/id"},
        "object": {"$ref": "#/$defs/subject_object"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "statement", "status", "method"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "status": {"enum": ["open", "confirmed", "disputed", "retracted"]},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "method": {"$ref": "#/$defs/method"},
        "targets": {"type": "array", "items": {"$ref": "#/$defs/finding_target"}},
        "attributes": {"type": "object"},
        "extensions": {"$ref": "https://deepagentlabs.github.io/ai-operations-spec/v0.4/common.schema.json#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "lineage_edge": {
      "type": "object",
      "required": ["id", "type", "source", "target"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["derived-from", "supports", "contradicts", "supersedes"]},
        "source": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "extensions": {"$ref": "https://deepagentlabs.github.io/ai-operations-spec/v0.4/common.schema.json#/$defs/extensions"}
      },
      "additionalProperties": false
    }
  }
}
