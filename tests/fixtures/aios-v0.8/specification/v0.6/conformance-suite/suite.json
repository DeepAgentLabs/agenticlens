            "digest": "mismatch"
          }
        },
        "references": {
          "source-evaluation": "unresolved",
          "source-retrieval": "unresolved",
          "finding-grounded/targets/0": "unresolved",
          "finding-stale-source/targets/0": "unresolved"
        }
      }
    },
    {
