{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepagentlabs.github.io/agenticlens/schemas/suites/duplicate-report.schema.json",
  "$defs": {
    "DuplicateGroup": {
      "properties": {
        "kind": {
          "enum": [
            "exact",
            "near"
          ],
          "title": "Kind",
          "type": "string"
        },
        "case_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Case Ids",
          "type": "array"
        },
        "keep": {
          "description": "Case kept when duplicates are dropped (the first one).",
          "title": "Keep",
          "type": "string"
        },
        "similarity": {
          "description": "Lowest pairwise similarity in the group.",
          "maximum": 1,
          "minimum": 0,
          "title": "Similarity",
          "type": "number"
        },
        "conflicting": {
          "description": "True when the cases share an input but expect different results.",
          "title": "Conflicting",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "case_ids",
        "keep",
        "similarity",
        "conflicting"
      ],
      "title": "DuplicateGroup",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "suite_name": {
      "title": "Suite Name",
      "type": "string"
    },
    "threshold": {
      "maximum": 1,
      "minimum": 0,
      "title": "Threshold",
      "type": "number"
    },
    "total_cases": {
      "title": "Total Cases",
      "type": "integer"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/DuplicateGroup"
      },
      "title": "Groups",
      "type": "array"
    },
    "duplicate_case_ids": {
      "description": "Every grouped case except the one kept.",
      "items": {
        "type": "string"
      },
      "title": "Duplicate Case Ids",
      "type": "array"
    },
    "conflicting_groups": {
      "default": 0,
      "title": "Conflicting Groups",
      "type": "integer"
    }
  },
  "required": [
    "suite_name",
    "threshold",
    "total_cases"
  ],
  "title": "AgenticLens Duplicate Report",
  "type": "object"
}
