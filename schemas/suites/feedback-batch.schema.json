{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepagentlabs.github.io/agenticlens/schemas/suites/feedback-batch.schema.json",
  "$defs": {
    "FeedbackRecord": {
      "description": "User feedback about one agent response.\n\nPositive feedback confirms `output`; negative feedback needs a\n`corrected_output` to become a test case. `score` (0-1) is used only when\n`rating` is absent, with 0.5 and above counting as positive.",
      "properties": {
        "feedback_id": {
          "minLength": 1,
          "title": "Feedback Id",
          "type": "string"
        },
        "input": {
          "default": null,
          "title": "Input"
        },
        "output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        },
        "rating": {
          "anyOf": [
            {
              "enum": [
                "positive",
                "negative"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "corrected_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corrected Output"
        },
        "comment": {
          "default": "",
          "title": "Comment",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "submitted_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Submitted By"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "feedback_id"
      ],
      "title": "FeedbackRecord",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "feedback": {
      "items": {
        "$ref": "#/$defs/FeedbackRecord"
      },
      "title": "Feedback",
      "type": "array"
    }
  },
  "required": [
    "feedback"
  ],
  "title": "AgenticLens Feedback Batch",
  "type": "object"
}
